<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts the datacenter control panel at login and restarts it if it exits.
  1. Replace /path/to/dc_panel.py and <windows-lan-ip> below.
  2. Copy to ~/Library/LaunchAgents/com.example.dcpanel.plist
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.dcpanel.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.dcpanel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/path/to/dc_panel.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DC_HOST</key>
        <string>&lt;windows-lan-ip&gt;</string>
        <key>DC_NAME</key>
        <string>Datacenter PC</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/tmp/dc_panel.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dc_panel.log</string>
</dict>
</plist>
